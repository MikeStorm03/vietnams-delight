{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "Zach's room",
        "MikeStorm03",
        "KainuMan"
    ],
    "contact": {
        "homepage": "https://modrinth.com/project/vietnams-delight-reborn",
        "sources": "https://github.com/MikeStorm03/vietnams-delight",
        "issues": "https://github.com/MikeStorm03/vietnams-delight/issues"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/9mgdeXJdsx"
            },
            "parent": "farmersdelight"
        }
    },
    "license": "${license}",
    "icon": "${mod_id}_icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.msg.vietnamsdelight.VietnamsDelight"
        ],
        "client": [
            "com.msg.vietnamsdelight.Client"
